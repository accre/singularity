Bootstrap: docker
From: rockylinux:9

%arguments

	# Define the software versions we wish to build
	RSTUDIO_VERSION=2026.06.0-242
	R_VERSION=4.6.1
	LMOD_VERSION=8.7.56
	OPENBLAS_VERSION=0.3.34

        # These are the architectures to optimize OpenBLAS and R for:
        ### x86-64-v4 (doesn't build yet!)
        # ARCH_OPENBLAS=SKYLAKEX
        # ARCH_R=x86-64-v4
	# R doesn't build yet with v4, so use v3

	### x86-64-v3
	ARCH_OPENBLAS=HASWELL
	ARCH_R=x86-64-v3

%labels

	Maintainer Mathew Binkley <Mathew.Binkley@Vanderbilt.edu>
	Software RStudio Server {{ RSTUDIO_VERSION }} with R {{ R_VERSION }} optimized for {{ ARCH_R }}
	RStudio_Version {{ RSTUDIO_VERSION }}
	R_Version {{ R_VERSION }}

%help

	Singularity container for RStudio {{ RSTUDIO_VERSION }} and R {{ R_VERSION }} optimized for {{ ARCH_R }} for use with ACCRE OnDemand Visualization Portal.

%apprun rserver

	exec rserver "${@}"

%runscript

	exec rserver "${@}"

%environment

	export MODULEPATH_ROOT=/accre/arch/easybuild/modules/all
	export MODULEPATH=$MODULEPATH_ROOT/Core:$MODULEPATH_ROOT/BinDist
	export LMOD_SHORT_TIME=86400
	export LMOD_ADMIN_FILE=/accre/common/lmod/etc/admin.lmod
	export LMOD_RC=/accre/common/lmod/etc/lmodrc.lua
	source /usr/local/lmod/lmod/init/bash
	export PATH=/usr/lib/rstudio-server/bin:${PATH}
	# Enable the lmod line below if you're using the lmod version of R instead of the Singularity R
	#  ml GCC/10.2.0 OpenMPI/4.0.5 R/4.0.5

%setup

	install -Dv accre_lmod_bash_profile    ${SINGULARITY_ROOTFS}/etc/profile.d/accre_01_lmod.sh
	install -Dv rstudio_auth.sh            ${SINGULARITY_ROOTFS}/usr/lib/rstudio-server/bin/rstudio_auth
	install -Dv accre_rstudio_bash_profile ${SINGULARITY_ROOTFS}/etc/profile.d/accre_02_rstudio.sh

%post

	# Enable the EPEL repo and CRB
	dnf install -y 'dnf-command(config-manager)'
	dnf config-manager --set-enabled crb
	dnf update -y
	dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm

	# Install build dependencies
	dnf install -y \
		abseil-cpp-devel bc boost-devel bzip2 bzip2-devel cairo-devel chromium cmake cyrus-sasl-devel \
		diffutils fftw-devel file fontconfig-devel freetype-devel fribidi-devel gcc gcc-c++ gcc-gfortran \
		gdal gdal-devel gdal-libs geos geos-devel git glibc-langpack-en glpk-devel gmp-devel gsl-devel \
		harfbuzz-devel hdf5-devel hiredis-devel hwloc-devel ImageMagick-devel ImageMagick-c++-devel \
		java-11-openjdk java-11-openjdk-devel jq-devel leptonica-devel libarchive-devel libavfilter-free-devel \
		libcurl-devel libevent-devel libgit2-devel libicu-devel libjpeg-devel libjpeg-turbo-devel libgomp \
		libomp-devel libpng-devel libpq-devel librsvg2-devel libsecret-devel libsndfile-devel libsodium-devel \
		libssh-devel libssh2-devel libtiff-devel libuv-devel libwebp-devel libX11-devel libxml2-devel libXt-devel libzstd-devel \
		llvm-libs make mariadb-devel mesa-libGL-devel mesa-libGLU-devel mpfr-devel netcdf-devel nodejs-libs \
		openmpi openssl-devel pamtester pcre2-devel perl poppler-cpp-devel procps proj proj-devel \
		protobuf-compiler protobuf-devel python3 python3-devel readline readline-devel \
		sqlite-devel tar tcl tesseract-devel texlive texlive-latex texlive-pdftex tk tk-devel tzdata \
		udunits2-devel unixODBC-devel wget which xz xz-devel zeromq-devel zlib-devel
	dnf clean all

	# Ensure locale is set to en_US.UTF-8
	echo "LANG=en_US.UTF-8" > /etc/locale.conf

	# Install Lmod
	dnf -y install lua lua-filesystem lua-posix lua-term lua-devel
	wget https://github.com/TACC/Lmod/archive/{{ LMOD_VERSION }}.tar.gz
	echo "b7ee903b79ccd5bf195921f09bfc13879ad09d2b4598f4a0c2346bad9faaf28c  {{ LMOD_VERSION }}.tar.gz" | sha256sum -c -
	tar xzf {{ LMOD_VERSION }}.tar.gz
	cd Lmod-{{ LMOD_VERSION }}
	./configure --with-spiderCacheDir=/accre/arch/lmod/cache \
	      --with-updateSystemFn=/accre/arch/lmod/cache/timestamp.lmod \
	      --with-tcl=no
	make install
	cd ..
	rm -rf {{ LMOD_VERSION }}.tar.gz Lmod-{{ LMOD_VERSION }}

	# Install RStudio Server
	wget https://download2.rstudio.org/server/rhel9/x86_64/rstudio-server-rhel-{{ RSTUDIO_VERSION }}-x86_64.rpm
	echo "3120f4dc32247712060b1d133c50929b8ee3dae29c5eb85e9fe0134e2ecad80d  rstudio-server-rhel-{{ RSTUDIO_VERSION }}-x86_64.rpm" | sha256sum -c -
	dnf -y install rstudio-server-rhel-{{ RSTUDIO_VERSION }}-x86_64.rpm
	rm -f rstudio-server-rhel-{{ RSTUDIO_VERSION }}-x86_64.rpm

	# Install OpenBLAS (before R, so R can link against it)
	git clone --depth 1 --branch v{{ OPENBLAS_VERSION }} https://github.com/OpenMathLib/OpenBLAS
	cd OpenBLAS
	make -j TARGET={{ ARCH_OPENBLAS }}
	make PREFIX=/usr/local/openblas install
	cd ..
	rm -rf OpenBLAS

	# Install R (linked against OpenBLAS)
	wget https://cran.r-project.org/src/base/R-4/R-{{ R_VERSION }}.tar.gz
	echo "4da6e61d2c0aac5f14a2e7e432cb5fcc269efe83da4293050ba7f03dff4e2cf4  R-{{ R_VERSION }}.tar.gz" | sha256sum -c -
	tar -xf R-{{ R_VERSION }}.tar.gz
	cd R-{{ R_VERSION }}
	FFLAGS="-march={{ ARCH_R}} -I/usr/local/openblas/include" \
	CFLAGS="-march={{ ARCH_R }} -I/usr/local/openblas/include" \
	./configure --enable-R-shlib \
            --with-blas="-L/usr/local/openblas/lib -lopenblas" \
            --with-lapack="-L/usr/local/openblas/lib -lopenblas"
	make -j
	make install
	cd ..
	rm -rf R-{{ R_VERSION }}
	rm -rf R-{{ R_VERSION }}.tar.gz

	# Replace R's bundled BLAS with the OpenBLAS we already linked against
	rm -f /usr/local/lib64/R/lib/libRblas.so
	ln -s /usr/local/openblas/lib/libopenblas.so /usr/local/lib64/R/lib/libRblas.so
	echo "/usr/local/openblas/lib" > /etc/ld.so.conf.d/openblas.conf
	ldconfig

	# Install CRAN packages in the image
	# /usr/local/bin/Rscript -e 'install.packages(c("tidyverse", "lubridate", "purrr", "broom"), repos = "https://cloud.r-project.org")'

	# Install Bioconductor packages in the image
	# /usr/local/bin/Rscript -e 'install.packages("BiocManager", repos = "https://cloud.r-project.org")'
	# /usr/local/bin/Rscript -e 'BiocManager::install(version = "3.20")'
	# /usr/local/bin/Rscript -e 'BiocManager::install(c("BiocVersion", "GenomicAlignments", "preprocessCore"))'

	# Create folders for bind mounting
	mkdir -p /accre /afs /cvmfs /data /dors /gpfs51 /labs /nobackup /panfs /programs /run/user /sb /store /v5000

	# Overwrite /etc/pam.d/rstudio with something more appropriate
	cp /etc/pam.d/login /etc/pam.d/rstudio

	# Remove files that are no longer necessary after building
	dnf clean all -y
	rpm -e texlive $(rpm -qa | grep texlive)
	rpm -e perl perl-CPAN annobin redhat-rpm-config perl-devel python-srpm-macros go-srpm-macros fonts-srpm-macros perl-ExtUtils-Embed perl-ExtUtils-Miniperl perl-ExtUtils-CBuilder

%test

	# Verify that R starts properly
	R --version
